PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=generate-with-crypto-randomBytes-48
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
SEED_USER_PASSWORD=choose-a-strong-dev-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@grupoglobal.es

# Scheduled jobs
BACKUP_INTERVAL_HOURS=24
BACKUP_CONTAINER=grupo_global_db
RECYCLE_BIN_RETENTION_DAYS=30

# Login attempts allowed per 15 minutes per IP (default: 10 in production, 100 otherwise)
LOGIN_RATE_LIMIT=

# Company mailbox sync (Emails > Inbox). Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_DAYS=7
IMAP_SYNC_MINUTES=5
# Messages not addressed to any platform user are delivered to this user.
IMAP_FALLBACK_RECIPIENT=

# File storage: "local" (disk) or "s3".
STORAGE_DRIVER=local
# Encrypts files on local disk with AES-256-GCM. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key safe: files cannot be read without it.
STORAGE_ENCRYPTION_KEY=
# S3 (EU region recommended for GDPR). Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars or an instance role).
S3_BUCKET=
S3_REGION=eu-south-2
S3_KMS_KEY_ID=
# Optional S3-compatible endpoint (e.g. MinIO); leave empty for AWS.
S3_ENDPOINT=
# Also copy database backups to S3 (off-site).
BACKUP_TO_S3=false
