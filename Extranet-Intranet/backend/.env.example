PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=generate-with-crypto-randomBytes-48
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
SEED_USER_PASSWORD=choose-a-strong-dev-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@grupoglobal.es

# Scheduled jobs
BACKUP_INTERVAL_HOURS=24
# Local backups older than this are deleted (the newest 7 of each type are always kept). 0 keeps all.
BACKUP_RETENTION_DAYS=30
BACKUP_CONTAINER=grupo_global_db
RECYCLE_BIN_RETENTION_DAYS=30

# Login attempts allowed per 15 minutes per IP (default: 10 in production, 100 otherwise)
LOGIN_RATE_LIMIT=

# Company mailbox sync (Emails > Inbox). Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_DAYS=7
IMAP_SYNC_MINUTES=5
# Messages not addressed to any platform user are delivered to this user.
IMAP_FALLBACK_RECIPIENT=

# File storage: "local" (disk) or "s3".
STORAGE_DRIVER=local
# Encrypts files on local disk with AES-256-GCM. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key safe: files cannot be read without it.
STORAGE_ENCRYPTION_KEY=
# SCORM / xAPI course packages: largest .zip HR can upload (MB). Packages are unpacked
# into UPLOAD_DIR/course-packages on this server, also when STORAGE_DRIVER=s3.
COURSE_PACKAGE_MAX_MB=300
# S3 (EU region recommended for GDPR). Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars or an instance role).
S3_BUCKET=
S3_REGION=eu-south-2
S3_KMS_KEY_ID=
# Optional S3-compatible endpoint (e.g. MinIO); leave empty for AWS.
S3_ENDPOINT=
# Also copy database backups to S3 (off-site).
BACKUP_TO_S3=false

# Mandatory MFA for Super Admin, Tech Admin and HR (Technical Spec 3.1). Set true in production.
MFA_ENFORCE=false
# Security keys (WebAuthn) only work on this domain and on the FRONTEND_ORIGIN address(es).
# Set before go-live, for example app.grupoglobalplataformabilateral.com.es. Changing it invalidates registered keys.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Global Group

# Immutable audit copies. Use a separate bucket created with S3 Object Lock enabled.
AUDIT_S3_BUCKET=
AUDIT_S3_REGION=eu-south-2
# Required to switch this on. Have legal confirm the period first.
AUDIT_RETENTION_DAYS=
# GOVERNANCE can be overridden by privileged AWS users. COMPLIANCE cannot be shortened or removed by anyone.
AUDIT_LOCK_MODE=GOVERNANCE

# HMAC-SHA256 secret shared with the WordPress site for signed CRM lead webhooks (POST /api/webhooks/crm-lead).
WEBHOOK_SECRET=

# Investor Vault: separate AES-256 key for investor profiles (32 bytes, base64). Production: load from AWS KMS / HashiCorp Vault.
VAULT_ENCRYPTION_KEY=

# ---- Key-ready integrations (all off until set) ----
# Investor Vault key provider: local (default), aws_kms or hashicorp.
# After switching: node database/scripts/reencrypt-vault.js (dry-run), then --apply.
VAULT_KEY_PROVIDER=local
VAULT_KMS_KEY_ID=
VAULT_KMS_REGION=
VAULT_TRANSIT_ADDR=
VAULT_TRANSIT_TOKEN=
VAULT_TRANSIT_KEY=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_NAMESPACE=
# LiveKit-compatible SFU. Empty = current WebRTC mesh (up to 8 people).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=
LIVEKIT_TOKEN_TTL_SECONDS=3600
# Signed video playback: mux or cloudflare. Private keys: PEM or base64 PEM.
STREAMING_PROVIDER=
STREAMING_TOKEN_TTL_SECONDS=3600
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
CF_STREAM_CUSTOMER_CODE=
CF_STREAM_KEY_ID=
CF_STREAM_PRIVATE_KEY=
# Video bio uploads + automatic transcripts (same provider as STREAMING_PROVIDER).
# Webhook URL to register at the provider: https://<api-domain>/api/webhooks/mux or /api/webhooks/cloudflare-stream
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_WEBHOOK_SECRET=
# Video bio uploads allowed per person per day (default 10).
VIDEO_BIO_DAILY_LIMIT=10
# Monitoring. Uptime monitors call GET /api/health/ready (503 when the database is down).
# SENTRY_DSN: error reports to Sentry (optional). APP_RELEASE: version shown in reports and on System health.
# LOG_REQUESTS=false turns off the one-line JSON access log. MONITORING_ALERT_EMAIL: who gets job-failure
# emails (default: active administrators).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
APP_RELEASE=
LOG_REQUESTS=true
MONITORING_ALERT_EMAIL=
# Privacy and data protection. Every user must accept the current policy version before using the platform;
# raise PRIVACY_POLICY_VERSION whenever the text changes and everyone is asked again. CONSENT_ENFORCE=false
# switches the check off (never in production). The URLs point to Grupo Global's published texts; when empty,
# the platform's built-in summary pages (/legal/privacy, /legal/terms, /legal/cookies) are shown.
PRIVACY_POLICY_VERSION=2026-11
CONSENT_ENFORCE=true
PRIVACY_POLICY_URL=
TERMS_URL=
COOKIE_POLICY_URL=
PRIVACY_CONTACT_EMAIL=
# Paid membership: how each paid membership invoice (net of VAT) is split between the partners.
# Format "Name:percent,Name:percent", adding up to 100. Prices are set on the Billing page (Plans).
MEMBERSHIP_REVENUE_SPLIT=Grupo Global:50,Zeta AI Labs:50
# Public "Ask Grupo Global" assistant. Uses ANTHROPIC_API_KEY when set (otherwise it matches the approved facts).
# ASSISTANT_MODEL overrides AI_MODEL for the public chat; ASSISTANT_DAILY_LIMIT caps questions per day.
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=1000
# Phone/desktop alerts (Web Push). Generate once: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact: mailto:it@your-domain or https://your-domain. Keep the same keys forever,
# changing them silently switches off alerts on every device. PUSH_HIDE_DETAILS=true shows only titles.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_HIDE_DETAILS=false
# Cloudflare edge (see docs/cloudflare.md).
CLOUDFLARE_ENABLED=false
CLOUDFLARE_TRUSTED_PROXIES=
CLOUDFLARE_ORIGIN_SECRET=

# EU VAT check (VIES). No key needed. When true, VAT numbers are sent to the European Commission.
VIES_ENABLED=false
# Use the official test service. VAT number 100 is valid and 200 is invalid.
VIES_USE_TEST_SERVICE=false

# Single sign-on (OIDC), e.g. a WordPress OIDC server. Off until the first four are set.
# The provider must send a verified email. Register OIDC_REDIRECT_URI with it:
# https://<app-domain>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_PROVIDER_NAME=Grupo Global
OIDC_SCOPES=openid email profile

# Automatic AML screening (OpenSanctions). Paid per check; commercial use needs their licence.
# Sends company name, country and tax ID to OpenSanctions when Compliance runs a check.
AML_PROVIDER=
OPENSANCTIONS_API_KEY=
# Match confidence from 0.5 to 1. Default 0.7; higher means fewer false alarms.
AML_MATCH_THRESHOLD=0.7

# Online invoice payments. Webhook URLs to register with each provider:
#   https://<app-domain>/api/webhooks/stripe   (events: checkout.session.completed, checkout.session.async_payment_succeeded)
#   https://<app-domain>/api/webhooks/paypal   (events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# POS card readers (Stripe Terminal, server-driven). Register readers in the Stripe dashboard, then list them:
#   STRIPE_TERMINAL_READERS=tmr_abc123:Front desk,tmr_def456:Warehouse
STRIPE_TERMINAL_READERS=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENV=sandbox

# Signed-in navigation on the public WordPress site. Add to the site template:
#   <div id="gg-nav"></div><script src="https://<app-domain>/api/public/nav.js" async></script>
# Comma-separated site addresses allowed to ask who is signed in:
NAV_ALLOWED_ORIGINS=
# Parent domain so the site and the app share the cookie, e.g. .grupoglobalplataformabilateral.com.es
NAV_COOKIE_DOMAIN=

# Company accounts. Google: service account with domain-wide delegation for the scope
# https://www.googleapis.com/auth/admin.directory.user (private key as base64 of the PEM).
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# A Workspace admin the service account acts for
GOOGLE_ADMIN_SUBJECT=
GOOGLE_WORKSPACE_DOMAIN=
# Microsoft: Entra app registration with application permission User.ReadWrite.All (admin consent).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DOMAIN=
# true = suspending someone here also suspends their Google / Microsoft sign-in
PROVISIONING_AUTO_SUSPEND=false

# AI assistant (Claude by Anthropic): record and document summaries, smart search, CRM next steps.
# Off until the key is set. Content the user can already open is sent to Anthropic's API.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5) and AI requests per user per day (default 100).
AI_MODEL=
AI_DAILY_LIMIT=100
