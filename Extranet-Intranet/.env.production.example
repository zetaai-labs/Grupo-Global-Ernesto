# Copy to .env.production on the server. Never commit the real file.
# Generate each secret separately:  openssl rand -hex 32  (or -base64 32 where noted)

APP_VERSION=latest
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Proxies in front of the app. 1 = this nginx only. Use 2 if a host proxy or load balancer sits in front.
TRUST_PROXY_HOPS=1

DB_USER=grupo_global
DB_NAME=grupo_global
# Letters and digits only, because it is placed inside a connection URL.
DB_PASSWORD=

FRONTEND_ORIGIN=https://app.grupoglobalplataformabilateral.com.es
JWT_SECRET=
# Base64 of 32 random bytes.
STORAGE_ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY=
WEBHOOK_SECRET=
MFA_ENFORCE=true
WEBAUTHN_RP_ID=app.grupoglobalplataformabilateral.com.es
WEBAUTHN_RP_NAME=Global Group
COMPANY_ADDRESS=

# Email, storage, SSO, video and other services: copy the settings you need from backend/.env.example.
