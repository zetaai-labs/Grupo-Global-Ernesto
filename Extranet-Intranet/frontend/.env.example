# Frontend (Vite) settings — copy to .env.local
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=http://localhost:5000

# Video conferencing (WebRTC). STUN is enough on open networks;
# add a TURN relay (e.g. coturn on the Grupo Global VPS) for calls across corporate/NAT networks.
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
